# Application Environment
ENVIRONMENT=development
PROJECT_NAME="PriceFinder BD API"
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-at-least-32-chars

# Database Configuration (Supabase PostgreSQL / Local PostgreSQL / SQLite for tests)
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./pricefinder_dev.db

# Supabase Auth Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google Maps API (Optional server-side geocoding)
GOOGLE_MAPS_API_KEY=

# Optional AI Vision Provider (Backend-only, never expose to client)
GEMINI_API_KEY=
